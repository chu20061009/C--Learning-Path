#include <iostream>

int main() {

	int arr[] = { 1,3,2,5,4 };
	for (int i = 0; i < 5; i++) { 
		std::cout << arr[i]; 
	}
	int start = 0;//起始元素下標位置
	int end = sizeof(arr)/sizeof(arr[0]) - 1;//最後的元素的下標位置
	while(start < end){//逆置的循環
		int temp = arr[start];
		arr[start] = arr[end];
		arr[end] = temp;
		end--;
		start++;
	}
	std::cout << "\n";
	for (int i = 0; i < 5; i++) {
		std::cout << arr[i];
	}
	std::cin.get();
	return 0;
}
