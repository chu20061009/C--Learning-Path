#include <iostream>

int main() {

	//數組
	/*
	定義形式
	1.數據類型 [數組長度];
	2.數據類型 [數組長度] = {值1, 值2, ...};
	3.數據類型 [] = {值1, 值2, ...};
	*/
	int arr[5];
	//對數組中的元素進行賦值
	arr[0] = 10;//從0開始
	arr[1] = 20;
	arr[2] = 30;
	arr[3] = 40;
	arr[4] = 50;
	//訪問數組元素
	std::cout << arr[0] << std::endl;


	int arr2[5] = { 10,20,30,40,50 };//如果在初始化數據時，未填寫完全，會用0來填補剩餘數據
	std::cout << arr2[0] << std::endl;


	int arr3[] = { 10,20,30,40,50,60 };
	for (int i = 0; i < 5; i++) {
		std::cout << arr3[i] << std::endl;
	}
	std::cin.get();
	return 0;
}
