#include <iostream>
//對象的初始化和清理
//1.構造函數，進行初始化操作
class Person {
	//構造函數沒有返回值也不用寫void
	//函數名稱與類名相同
	//構造函數可以有參數，可以發生重載
	//創造對象時，構造函數會自動調用且只調用一次

public:
	Person() {
		std::cout << "Person構造函數的調用" << std::endl;
	};

	//析構函數，進行清理的操作
	//沒有返回值，也不寫void
	//函數名稱與類名相同，在名稱前面加上~
	//對象在銷毀前，會自動調用析構函數，而且只會調用一次
	~Person() {
		std::cout << "Person析構函數的調用" << std::endl;
	}

};

void test01() {
	Person p;
}

int main(){
	test01();

	std::cin.get();
	return 0;
}
