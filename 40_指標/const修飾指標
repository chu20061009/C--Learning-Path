#include <iostream>

int main() {
	
	int a = 10;
	int b = 10;
	const int* p = &a;//常量指標，指標指向的值不可以改，指標的指向可以改
	//*p = 20; 錯誤
	p = &b;

	int* const p2 = &a;//指針常量，指標指向的值可以改，指標的指向不可以改
	//p2 = &b;錯誤
	*p2 = 100;

	const int* const p3 = &a;//指標指向的值不可以改，指標的指向也不可以改
	//p3 = &b;錯誤
	//*p3 = 100;錯誤



	std::cin.get();
	return 0;
}
