#include <iostream>
#include <string>

struct student {
	std::string name;
	int age;
	int score;
};

void print(const student *s) {//使用指針可以減少使用內存空間
	//s->age = 150;加入const之後，一但有修改的操作就會報錯，防止誤操作
	std::cout << "姓名：" << s->name << " 年齡：" << s->age << " 分數：" << s->score << std::endl;
}

int main(){
	student s = { "張三", 18, 100 };
	print(&s);

	std::cin.get();
	return 0;
}
