#include <iostream>

void func() {//讓函數名稱相同，提高複用性
	std::cout << "This is func test" << std::endl;
}

void func(int a) {
	std::cout << "This is func(int a) test" << std::endl;
}

void func(double b) {
	std::cout << "This is func(double b) test" << std::endl;
}
/*
條件：1.在同一個作用域下
2.函數名稱相同
3.函數參數類型不同，或者個數不同，或者順序不同
*/

//注意事項
//1.引用作為重載條件
void fun(int &a) {
	std::cout << "This is fun(int &a) tesst" << std::endl;
}

void fun(const int &a) {
	std::cout << "This is fun(const int &a) tesst" << std::endl;
}
//2.函數重載遇到默認參數

void func2(int a) {
	std::cout << "This is func2(int a) test" << std::endl;
}

void func2(int a, int b = 10) {
	std::cout << "This is func2(int a, int b = 10) test" << std::endl;
}


int main(){
	func();
	func(10);
	func(3.14);

	int a = 10;
	fun(a);
	fun(10);

	//func2(10);當函數重載與到默認參數，會出現二義性，會報錯

	std::cin.get();
	return 0;
}
