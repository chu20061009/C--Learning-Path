#include <iostream>
#include <string>

int main() {
	int score[3][3] = {
		{100,100,100},
		{90,50,100},
		{60,70,80}
	};
	std::string name[3] = { "張三","李四","王五" };
	for (int i = 0; i < 3; i++) {
		int sum = 0;
		for (int j = 0; j < 3; j++) {
			sum += score[i][j];
		}
		std::cout << name[i ]<<"的總分為：" << sum;
		std::cout << "\n";
	}

	std::cin.get();
	return 0;
}
